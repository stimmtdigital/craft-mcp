<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true">
    <!-- Pest's architecture tests parse every source file and its vendor
         dependencies, which needs more than PHP's 128M default: the host CLI
         hit the ceiling and died mid-suite ("Premature end of PHP process")
         while the same tests passed in DDEV, whose limit is higher. Setting it
         here rather than in the composer script keeps the gate identical
         wherever it runs, including from an IDE. -->
    <php>
        <ini name="memory_limit" value="512M"/>
    </php>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- Arch lives outside tests/Unit, so it needs its own suite or it is
             never collected. Keep it listed here: a plain `pest` run (composer
             ci) executes every suite, and `composer test:arch` selects this
             one by name instead of guessing at test names with a filter. -->
        <testsuite name="Arch">
            <file>tests/ArchTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
        <exclude>
            <directory>src/tools</directory>
        </exclude>
    </source>
</phpunit>
