    "tools": {
        "stimmt_activity_recent": {
            "title": "Recent changes",
            "description": "A newest-first feed of entry changes across every section: who saved or deleted which entry, and when. Built from Craft's revisions (one per save of a live entry, kind \"created\" for revision 1, \"updated\" after) plus soft-deleted entries (kind \"deleted\", changedBy null because Craft does not record who deleted). Only sections the connected user may view appear. Sections with versioning switched off, unsaved drafts, and revisions Craft has already pruned (maxRevisions) do not appear. offset + limit may not exceed 500.",
            "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true
            },
            "inputSchema": {
                "type": "object",
                "properties": {
                    "since": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Earliest change to include: any date Craft parses, such as \"2026-11-01\", \"2026-11-01T09:00:00+01:00\" or \"-3 days\". Defaults to 7 days ago."
                    },
                    "section": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Section handle to narrow the feed to. Omit for every section the user may view."
                    },
                    "author": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Username or email of the user whose saves to list. Deletions are left out when this is set, because Craft does not record who deleted an entry."
                    },
                    "limit": {
                        "type": "integer",
                        "default": 50,
                        "description": "How many rows to return. 1 or greater.",
                        "minimum": 1
                    },
                    "offset": {
                        "type": "integer",
                        "default": 0,
                        "description": "How many rows to skip before the first returned row. 0 or greater.",
                        "minimum": 0
                    }
                }
            }
        },
        "stimmt_assets_unused": {
            "title": "Unused assets",
            "description": "Assets nothing in Craft refers to, largest first. \"Unused\" means not referenced in Craft: no relation to it from any field, no {asset:ID} reference tag in any content, and not a user photo, counting canonical elements and drafts but not revisions or the trash. Templates, front-end code, other sites or emails may still hardcode its URL, so treat this as a list to review, never a list to delete: confirm with a person before removing anything. \"totalBytes\" sums every match, not only this page. Only volumes you may view are listed. Refused rather than answered partially when more than 20000 content rows carry asset tags, or the tags name more than 10000 distinct assets.",
            "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true
            },
            "inputSchema": {
                "type": "object",
                "properties": {
                    "volume": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Volume handle. Omit to list unused assets from every volume you may view."
                    },
                    "olderThan": {
                        "type": "integer",
                        "default": 0,
                        "description": "Only assets created at least this many days ago. 0 (default) for any age.",
                        "minimum": 0
                    },
                    "limit": {
                        "type": "integer",
                        "default": 100,
                        "description": "How many assets to return, 1 to 500.",
                        "minimum": 1,
                        "maximum": 500
                    },
                    "offset": {
                        "type": "integer",
                        "default": 0,
                        "description": "How many rows to skip before the first returned row. 0 or greater.",
                        "minimum": 0
                    }
                }
            }
        },
        "stimmt_categories_list": {
            "title": "Browse categories",
            "description": "List categories from Craft CMS. Filter by group handle.",
            "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true
            },
            "inputSchema": {
