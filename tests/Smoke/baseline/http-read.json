                    "limit": {
                        "type": "integer",
                        "default": 100,
                        "description": "How many rows to return. 1 or greater.",
                        "minimum": 1
                    },
                    "offset": {
                        "type": "integer",
                        "default": 0,
                        "description": "How many rows to skip before the first returned row. 0 or greater.",
                        "minimum": 0
                    }
                }
            }
        },
        "stimmt_drafts_diff": {
            "title": "What a draft changes",
            "description": "Before publishing, show field by field what a draft changes compared with its live (canonical) entry: title, slug, entry type, enabled, enabled for the site, post and expiry date, structure parent, and every custom field. Each change reads {field, label, kind: added|removed|changed, before, after}; text over 500 characters is cut and flagged truncated. Matrix fields report per block under \"blocks\" (added, removed, moved or changed blocks by block id and type) and ContentBlock fields report their own fields under \"changes\". Relations read as natural keys. A draft of an entry that was never published has no live entry: newEntry is true and every non-empty value reads as added. Takes the same id stimmt_drafts_publish does; revisions and provisional (autosaved) drafts are refused.",
            "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true
            },
            "inputSchema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "A draft element id, or a canonical entry id that has exactly one pending draft."
                    },
                    "site": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Site handle to compare on. Omit for the primary site."
                    }
                },
                "required": [
                    "id"
                ]
            }
        },
        "stimmt_entries_count": {
            "title": "Count and group entries",
            "description": "Count entries, optionally grouped: by attribute (status, type, section, site, author), by date bucket (\"month:dateUpdated\", day|week|month|year with dateCreated|dateUpdated|postDate), or by a field handle (relation fields bucket by related title, empty values under \"(empty)\"). Nested Matrix blocks are left out unless includeNested. Counts include EVERY status by default; pass status to narrow. One call answers \"how many per X\" without listing anything.",
            "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true
            },
            "inputSchema": {
                "type": "object",
                "properties": {
                    "section": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Section handle to count within. Omit to count across every section, which is every top-level entry the install has."
                    },
                    "includeNested": {
                        "type": "boolean",
                        "default": false,
                        "description": "Count nested Matrix blocks alongside top-level entries. Left out by default."
                    },
                    "type": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Entry type handle."
                    },
                    "status": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Entry status: live, pending, expired, disabled, or \"any\". Omitted counts every status."
                    },
                    "site": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Site handle. Omit for the primary site."
                    },
                    "search": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Craft search query."
                    },
                    "filters": {
                        "type": "object",
                        "default": null,
                        "description": "Field-value filters: {fieldHandle: value}. Values are scalars, \":empty:\", \":notempty:\", or a natural key object for relation fields.",
                        "additionalProperties": true
                    },
                    "relatedTo": {
                        "type": "object",
                        "default": null,
                        "description": "Only entries related to this element, as a natural key: {\"section\",\"slug\"}, {\"volume\",\"filename\"}, {\"group\",\"slug\"}, or {\"username\"}.",
                        "additionalProperties": true
                    },
                    "author": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Author username or email address."
                    },
                    "updatedAfter": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Lower bound on dateUpdated, inclusive. Any date Craft parses, such as \"2026-01-31\"."
                    },
                    "updatedBefore": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Upper bound on dateUpdated, exclusive."
                    },
                    "createdAfter": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Lower bound on dateCreated, inclusive."
                    },
                    "createdBefore": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Upper bound on dateCreated, exclusive."
                    },
                    "groupBy": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "What to bucket the count by: an attribute (status, type, section, site, author), a date bucket such as \"month:dateUpdated\", or a field handle. Omit for a plain total."
                    }
                }
            }
        },
        "stimmt_entries_preview_url": {
            "title": "Preview link for an entry or draft",
            "description": "A link that renders an entry or draft as saved, without logging in, for a person to review before publishing. Pass the draft's element id to preview unpublished changes. Refuses entries in sections without URLs. The link expires (previewTokenDuration, or Craft's defaultTokenDuration).",
            "annotations": {
                "readOnlyHint": true
            },
            "inputSchema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "Entry or draft element id."
                    },
                    "site": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Site handle. Omit for the primary site."
                    }
                },
                "required": [
                    "id"
                ]
            }
        },
        "stimmt_entries_untranslated": {
            "title": "Translation gaps",
            "description": "On a multi-site install, list entries whose content on a target site is still untranslated: a value the source site has that the target site leaves empty (\"empty\") or holds unchanged (\"same-as-source\"). Only values the two sites keep apart are checked: custom fields Craft translates per site for these two sites, plus title and slug when the entry type translates them. Values empty on the source are ignored. Relations compare by the elements they point at; Matrix blocks by type and content. limit bounds the entries SCANNED, not the entries returned, so one call never walks the whole install: total counts the gaps found in this window, scanned the entries looked at, and hasMore says whether to call again at offset + scanned. An entry that does not exist on the target site at all reads missingOnSite: true.",
            "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true
            },
            "inputSchema": {
                "type": "object",
                "properties": {
                    "site": {
                        "type": "string",
                        "description": "Target site handle: the site whose translations to check."
                    },
                    "section": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Section handle to scan. Omit to scan every section enabled on both sites."
                    },
                    "sourceSite": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Site handle to compare against. Omit for the primary site."
                    },
                    "limit": {
                        "type": "integer",
                        "default": 50,
                        "description": "How many source-site entries to scan, not how many to return. 1 or greater.",
                        "minimum": 1
                    },
                    "offset": {
                        "type": "integer",
                        "default": 0,
                        "description": "How many rows to skip before the first returned row. 0 or greater.",
                        "minimum": 0
                    }
                },
                "required": [
                    "site"
                ]
            }
        },
        "stimmt_links_broken": {
            "title": "Broken internal links",
            "description": "Entries whose content links to an entry, asset or category that is not live on the site the link is shown on. Reads relation fields (relations table) and the reference tags rich text and Link fields store ({entry:12@1:url}), in each entry and every nested entry beneath it. Reasons: deleted (in the trash), disabled (or archived), expired, pending, missing (no such element on that site), draft-only (the target is a draft). Pages through entries, not findings: limit entries are scanned per call (at most 1000, with up to 5000 nested entries, 8 levels deep, and 50000 relations between them; more is refused), and \"total\"/\"hasMore\" count entries, so ask again at offset + limit to scan the rest. Nested entries deeper than 8 levels are not followed. Lists only entries you may view; a target you may not view shows its id and reason, no title. \"unchecked\" counts tags that name a target by slug rather than id, which are not checked.",
            "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true
            },
            "inputSchema": {
                "type": "object",
                "properties": {
                    "section": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Section handle. Omit to scan entries from every section."
                    },
                    "site": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Site handle the links are checked for. Omit for the primary site."
                    },
                    "limit": {
                        "type": "integer",
                        "default": 200,
                        "description": "How many entries to scan, 1 to 1000.",
                        "minimum": 1,
                        "maximum": 1000
                    },
                    "offset": {
                        "type": "integer",
                        "default": 0,
                        "description": "How many entries to skip before the first scanned one. 0 or greater.",
                        "minimum": 0
                    }
                }
            }
        },
        "stimmt_redirects_404s": {
            "title": "Most frequent 404s",
            "description": "Retour's 404 statistics, most-hit first: the missing URL, its hit count, last hit, referrer (path only), whether a redirect handles it, and a suggested existing entry by slug similarity. The suggestion is a guess to check, not a redirect target to apply blindly.",
            "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true
            },
            "inputSchema": {
                "type": "object",
                "properties": {
                    "site": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Site handle. Omit for 404s on every site."
                    },
                    "days": {
                        "type": "integer",
                        "default": 30,
                        "description": "Only URLs last hit in the past N days, 1 to 3650. Hit counts are lifetime totals.",
                        "minimum": 1,
                        "maximum": 3650
                    },
                    "limit": {
                        "type": "integer",
                        "default": 20,
                        "description": "How many rows to return. 1 or greater.",
                        "minimum": 1
                    },
                    "offset": {
                        "type": "integer",
                        "default": 0,
                        "description": "How many rows to skip before the first returned row. 0 or greater.",
                        "minimum": 0
                    },
                    "excludeHandled": {
                        "type": "boolean",
                        "default": true,
                        "description": "Skip URLs a redirect already handles. Default true; pass false to audit those as well."
                    }
                }
            }
        },
        "stimmt_refs_resolve": {
            "title": "Natural key to element id",
            "description": "Turn a natural key into the element id Craft's elements_* tools take. Keys per type: entry {\"section\",\"slug\"}, asset {\"volume\",\"filename\"} (plus \"path\" for a file in a folder), category and tag {\"group\",\"slug\"}, user {\"username\"}, globalSet {\"handle\"}. Refuses a key that matches nothing, or several elements.",
            "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true
            },
            "inputSchema": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "description": "Element type: entry, asset, category, tag, user or globalSet.",
                        "enum": [
                            "entry",
                            "asset",
                            "category",
                            "tag",
                            "user",
                            "globalSet"
                        ]
                    },
                    "key": {
                        "type": "object",
                        "description": "The natural key, e.g. {\"section\": \"news\", \"slug\": \"launch\"}.",
                        "additionalProperties": true
                    },
                    "site": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Site handle, for types whose slugs differ per site. Omit for the primary site."
                    }
                },
                "required": [
                    "type",
                    "key"
                ]
            }
        },
        "stimmt_seo_gaps": {
            "title": "SEO gaps",
            "description": "Scan live entries for SEO metadata as SEOmatic resolves it (global, section and SEO Settings field merged, templates parsed): missing description, description or title over the SEOmatic max length, missing og:image, and noindex on a live entry (a flag, not an error). Only entries with issues are returned; page through with offset, which counts entries scanned.",
            "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true
            },
            "inputSchema": {
                "type": "object",
                "properties": {
                    "section": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Section handle. Omit to scan entries from every section that has URLs."
                    },
                    "site": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "default": null,
                        "description": "Site handle. Omit for Craft's primary site."
                    },
                    "limit": {
                        "type": "integer",
                        "default": 25,
                        "description": "How many entries to scan (not how many to return). 1 to 50.",
                        "minimum": 1,
                        "maximum": 50
                    },
                    "offset": {
                        "type": "integer",
                        "default": 0,
                        "description": "How many entries to skip before scanning. 0 or greater.",
                        "minimum": 0
                    }
                }
            }
        }
    },
